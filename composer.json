{
    "name": "stacknuts/magento-sort-rules",
    "description": "Enhance the storefront \"Sort By\" selector on the catalog listing toolbar with admin-configurable custom sort options, no template override or custom plugin required.",
    "type": "magento2-module",
    "keywords": ["magento2", "catalog", "sort-by", "toolbar", "product-listing", "elasticsuite", "opensearch"],
    "homepage": "https://github.com/StackNuts/magento-sort-rules",
    "authors": [
        {
            "name": "Phil Rowe",
            "email": "stack.nuts@outlook.com"
        }
    ],
    "support": {
        "issues": "https://github.com/StackNuts/magento-sort-rules/issues",
        "source": "https://github.com/StackNuts/magento-sort-rules"
    },
    "license": [
        "MIT"
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0",
        "magento/module-catalog": "*",
        "magento/module-config": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "StackNuts\\SortRules\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StackNuts\\SortRules\\Test\\": "Test/"
        }
    }
}
