<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Makes the storefront product-listing toolbar honour admin-configured sort rules. -->
    <type name="Magento\Catalog\Block\Product\ProductList\Toolbar">
        <plugin name="stacknuts_sortrules_apply_sort_rule"
                type="StackNuts\SortRules\Plugin\Catalog\Block\Product\ProductList\ApplySortRulePlugin" />
    </type>
</config>
